const groupItemsByTransaction = (items: any[]) => {
  const groups = new Map<number, any[]>()
  
  items.forEach(item => {
    if (!groups.has(item.transactions)) {
      groups.set(item.transactions, [])
    }
    groups.get(item.transactions)!.push(item)
  })
  
  return Array.from(groups.entries())
    .map(([transactionCount, items]) => ({
      transactionCount,
      items,
      itemNames: items.map(i => i.name),
      totalQuantity: items.reduce((sum, i) => sum + i.totalQuantity, 0),
      firstItem: items[0]
    }))
    .sort((a, b) => b.transactionCount - a.transactionCount)
}

