      multiplier = 0.3
      break
    case 'month':
      multiplier = 0.6
      break
    case '3months':
      multiplier = 0.8
      break
    case '6months':
      multiplier = 0.9
      break
    case 'all':
    default:
      multiplier = 1
      break
  }
  
  return baseTransactionItems.value.map(item => ({
    ...item,
    transactions: Math.round(item.transactions * multiplier) || 0,
    totalQuantity: Math.round(item.totalQuantity * multiplier) || 0
  }))
}

