const getTimeline = (request: PurchaseRequest) => {
  const events = []
  
  events.push({
    date: request.requestDate,
    title: '📝 Request Created',
    description: `Request submitted by ${request.requestedBy} from ${request.department}`,
    status: 'completed'
  })
  
  if (request.importedDate) {
    events.push({
      date: request.importedDate,
      title: '📥 Added to Follow-Up',
      description: 'Request added to purchase follow-up system',
      status: 'completed'
    })
  }
  
  if (request.bids && request.bids.length > 0) {
    const matchCount = request.bids.filter(b => b.matchesRequirement !== false).length
    const notMatchCount = request.bids.filter(b => b.matchesRequirement === false).length
    let desc = `${request.bids.length} prices submitted`
    if (notMatchCount > 0) {
      desc += ` (${notMatchCount} do not match requirements)`
    }
    events.push({
      date: request.bids[0].submittedDate,
      title: `💰 ${request.bids.length} Prices Submitted`,
      description: desc,
      status: request.status === 'bidding' ? 'active' : 'completed'
    })
  }
  
  if (request.paymentDetails) {
    events.push({
      date: request.paymentDetails.paymentDate,
      title: '💳 Payment Made',
      description: `Paid ETB ${request.paymentDetails.finalAmount.toFixed(2)} by ${request.paymentDetails.paidBy}`,
      status: 'completed'
    })
  }
  
  if (request.arrivalDetails) {
    events.push({
      date: request.arrivalDetails.arrivedDate,
      title: '📦 Arrived at SDT',
      description: request.arrivalDetails.remark || 'Items arrived at SDT warehouse',
      status: 'completed'
    })
  }
  
  return events
}

