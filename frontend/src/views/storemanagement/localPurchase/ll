<script setup lang="ts">
import { ref, computed, watch, onMounted } from 'vue'

// ================================================================
// TYPES
// ================================================================

interface AdditionalInfo {
  specs?: string
  notes?: string
  images?: string[]
}

interface ArrivalDetails {
  arrivedDate: string
  remark?: string
}

interface Bid {
  id: number
  employee: string
  price: number
  totalPrice?: number
  discount?: number
  finalPrice?: number
  submittedDate: string
  status: string
  isWinner: boolean
  matchesRequirement?: boolean
  remark?: string
  notes?: string
}

interface PaymentDetails {
  employee: string
  finalAmount: number
  paidBy: string
  transferNumber: string
  bank: string
  paymentDate: string
  remark?: string
}

interface PurchaseRequest {
  id: number
  requestNumber: string
  itemName: string
  quantity: number
  uom: string
  requestedBy: string
  department: string
  departmentId: number
  requestDate: string
  importedDate?: string
  status: 'pending_bids' | 'bidding' | 'purchased' | 'arrived'
  description?: string
  bids?: Bid[]
  paymentDetails?: PaymentDetails
  arrivalDetails?: ArrivalDetails
  additionalInfo?: AdditionalInfo
  selected?: boolean
  imported?: boolean
}

interface RemoveTarget {
  request: PurchaseRequest
  bid: Bid
}

interface EditTarget {
  request: PurchaseRequest
  bid: Bid
}

// ================================================================
// DEMO DATA
// ================================================================

const departments = [
  { id: 1, name: 'Production' },
  { id: 2, name: 'Maintenance' },
  { id: 3, name: 'Quality Control' },
  { id: 4, name: 'Warehouse' },
  { id: 5, name: 'Administration' },
  { id: 6, name: 'Sales' },
  { id: 7, name: 'IT' }
]

const employees = [
  { id: 1, name: 'Abebe Kebede', department: 'Sales' },
  { id: 2, name: 'Selam Tesfaye', department: 'Sales' },
  { id: 3, name: 'Mekonnen Alemu', department: 'Sales' },
  { id: 4, name: 'Tigist Hailu', department: 'Sales' },
  { id: 5, name: 'Dawit Solomon', department: 'Sales' },
  { id: 6, name: 'Meron Ayele', department: 'Sales' },
  { id: 7, name: 'Fikru Tsegaye', department: 'Sales' }
]

const requesters = [
  { name: 'Abebe Kebede', dept: 1 },
  { name: 'Selam Tesfaye', dept: 2 },
  { name: 'Mekonnen Alemu', dept: 3 },
  { name: 'Tigist Hailu', dept: 4 },
  { name: 'Dawit Solomon', dept: 5 },
  { name: 'Meron Ayele', dept: 6 },
  { name: 'Fikru Tsegaye', dept: 7 }
]

const items = [
  { name: 'Steel Pipe 2 inch', uom: 'PCS' },
  { name: 'Industrial Paint', uom: 'LTR' },
  { name: 'Conveyor Belt 10m', uom: 'ROLL' },
  { name: 'Hydraulic Pump', uom: 'SET' },
  { name: 'PVC Pipe 50mm', uom: 'PCS' },
  { name: 'Electrical Cable 100m', uom: 'ROLL' },
  { name: 'Motor 5HP', uom: 'SET' },
  { name: 'Aluminum Sheet', uom: 'KG' },
  { name: 'Bolts and Nuts Set', uom: 'BOX' },
  { name: 'Lubricant Oil', uom: 'LTR' }
]

const generateDemoRequests = (): PurchaseRequest[] => {
  const requests: PurchaseRequest[] = []
  
  for (let i = 1; i <= 20; i++) {
    const item = items[i % items.length]
    const requester = requesters[i % requesters.length]
    const dept = departments.find(d => d.id === requester.dept) || departments[0]
    
    const isImported = i % 3 !== 0
    const statuses: ('pending_bids' | 'bidding' | 'purchased' | 'arrived')[] = 
      ['pending_bids', 'pending_bids', 'bidding', 'purchased', 'arrived']
    
    const status = isImported ? statuses[i % statuses.length] : 'pending_bids'
    const requestDate = new Date()
    requestDate.setDate(requestDate.getDate() - (i * 2) - (i % 5))
    
    const request: PurchaseRequest = {
      id: i,
      requestNumber: `PR-2026-${String(1000 + i).padStart(4, '0')}`,
      itemName: item.name,
      quantity: 5 + (i * 3 % 15) + 1,
      uom: item.uom,
      requestedBy: requester.name,
      department: dept.name,
      departmentId: dept.id,
      requestDate: requestDate.toISOString().split('T')[0],
      importedDate: isImported ? new Date(requestDate.getTime() + 2 * 86400000).toISOString().split('T')[0] : undefined,
      status,
      description: i % 3 === 0 ? `Rush order for ${item.name}` : '',
      imported: isImported,
      selected: false
    }
    
    if (isImported) {
      const empCount = 2 + (i % 3)
      request.bids = []
      
      for (let j = 0; j < empCount; j++) {
        const emp = employees[(i + j) % employees.length]
        const basePrice = 100 + (i * 10) + (i % 5) * 10
        const price = basePrice + (j * 20) + (i % 3) * 5
        const matchesRequirement = i % 2 === 0
        const isWinner = (status === 'purchased' || status === 'arrived') && j === 0
        const discount = isWinner ? price * 0.05 : 0
        const totalPrice = price * request.quantity
        const finalPrice = totalPrice - discount
        
        request.bids.push({
          id: i * 10 + j,
          employee: emp.name,
          price: price,
          totalPrice: totalPrice,
          discount: discount,
          finalPrice: finalPrice,
          submittedDate: new Date(requestDate.getTime() + (j + 1) * 86400000).toISOString().split('T')[0],
          status: isWinner ? 'accepted' : (j === 0 ? 'pending' : 'rejected'),
          isWinner,
          matchesRequirement,
          remark: !matchesRequirement ? 'Size is different from specification' : undefined
        })
      }
    }
    
    if (isImported && (status === 'purchased' || status === 'arrived') && request.bids) {
      const winnerBid = request.bids.find(b => b.isWinner) || request.bids[0]
      request.paymentDetails = {
        employee: winnerBid.employee,
        finalAmount: winnerBid.finalPrice || winnerBid.price * request.quantity,
        paidBy: employees[(i + 2) % employees.length].name,
        transferNumber: `TRF-${String(2026000 + i)}`,
        bank: ['Commercial Bank of Ethiopia', 'Awash Bank', 'Dashen Bank'][i % 3],
        paymentDate: new Date(requestDate.getTime() + 8 * 86400000).toISOString().split('T')[0],
        remark: 'Payment processed successfully'
      }
      
      if (status === 'arrived') {
        request.arrivalDetails = {
          arrivedDate: new Date(requestDate.getTime() + 12 * 86400000).toISOString().split('T')[0],
          remark: 'Items arrived at SDT warehouse'
        }
      }
    }
    
    requests.push(request)
  }
  
  return requests
}

// ================================================================
// STATE
// ================================================================

const allRequests = ref<PurchaseRequest[]>(generateDemoRequests())
const loading = ref(false)
const searchQuery = ref('')
const filterStatus = ref('all')
const filterDepartment = ref('all')
const currentPage = ref(1)
const pageSize = ref(10)
const totalItems = ref(0)
const expandedRow = ref<number | null>(null)

const showImportModal = ref(false)
const showBidModal = ref(false)
const showPaymentModal = ref(false)
const showRemoveModal = ref(false)
const showEditModal = ref(false)
const showAddInfoModal = ref(false)
const showViewInfoModal = ref(false)
const showArrivedModal = ref(false)
const bidRequest = ref<PurchaseRequest | null>(null)
const paymentRequest = ref<PurchaseRequest | null>(null)
const removeTarget = ref<RemoveTarget | null>(null)
const editTarget = ref<EditTarget | null>(null)
const addInfoRequest = ref<PurchaseRequest | null>(null)
const viewInfoTarget = ref<PurchaseRequest | null>(null)
const arrivedRequest = ref<PurchaseRequest | null>(null)
const selectAll = ref(false)
const removeRemark = ref('')
const arrivedRemark = ref('')

const newBid = ref({
  employee: '',
  price: 0,
  totalPrice: 0,
  discount: 0,
  finalPrice: 0,
  matchesRequirement: true,
  remark: '',
  notes: ''
})

const editData = ref({
  price: 0,
  totalPrice: 0,
  discount: 0,
  finalPrice: 0,
  matchesRequirement: true,
  remark: '',
  notes: ''
})

const additionalInfoData = ref({
  specs: '',
  notes: '',
  images: [] as string[]
})

const paymentDetails = ref({
  employee: '',
  finalAmount: 0,
  paidBy: '',
  transferNumber: '',
  bank: 'Commercial Bank of Ethiopia',
  paymentDate: new Date().toISOString().split('T')[0],
  remark: ''
})

// ================================================================
// COMPUTED
// ================================================================

const followUpRequests = computed(() => allRequests.value.filter(r => r.imported === true))
const availableRequests = computed(() => allRequests.value.filter(r => r.imported === false))
const availableRequestsCount = computed(() => availableRequests.value.filter(r => !r.imported).length)

const pendingBids = computed(() => followUpRequests.value.filter(r => r.status === 'pending_bids').length)
const activeBidding = computed(() => followUpRequests.value.filter(r => r.status === 'bidding').length)
const purchasedCount = computed(() => followUpRequests.value.filter(r => r.status === 'purchased' || r.status === 'arrived').length)
const arrivedCount = computed(() => followUpRequests.value.filter(r => r.status === 'arrived').length)

const selectedForImport = computed(() => availableRequests.value.filter(r => r.selected))

const hasActiveFilters = computed(() => filterStatus.value !== 'all' || filterDepartment.value !== 'all' || searchQuery.value)

const isBidValid = computed(() => {
  return newBid.value.employee &&
    newBid.value.price > 0 &&
    (newBid.value.matchesRequirement !== false || (newBid.value.matchesRequirement === false && newBid.value.remark))
})

const isEditValid = computed(() => {
  return editData.value.price > 0 &&
    (editData.value.matchesRequirement !== false || (editData.value.matchesRequirement === false && editData.value.remark))
})

const isPaymentValid = computed(() => {
  return paymentDetails.value.employee &&
    paymentDetails.value.finalAmount > 0 &&
    paymentDetails.value.paidBy &&
    paymentDetails.value.transferNumber &&
    paymentDetails.value.bank
})

const filteredRequests = computed(() => {
  return followUpRequests.value.filter(req => {
    const matchSearch = !searchQuery.value ||
      req.requestNumber.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
      req.itemName.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
      req.requestedBy.toLowerCase().includes(searchQuery.value.toLowerCase())
    
    const matchStatus = filterStatus.value === 'all' || req.status === filterStatus.value
    const matchDepartment = filterDepartment.value === 'all' || req.departmentId === Number(filterDepartment.value)
    
    return matchSearch && matchStatus && matchDepartment
  })
})

const paginatedRequests = computed(() => {
  const start = (currentPage.value - 1) * pageSize.value
  const end = start + pageSize.value
  const items = filteredRequests.value.slice(start, end)
  totalItems.value = filteredRequests.value.length
  return items
})

const totalPages = computed(() => Math.ceil(totalItems.value / pageSize.value) || 1)

// ================================================================
// CHECK FUNCTIONS
// ================================================================

const isDisabled = (request: PurchaseRequest): boolean => {
  return request.status === 'arrived'
}

const isActionDisabled = (request: PurchaseRequest): boolean => {
  if (request.status === 'arrived') return true
  if (request.status === 'purchased') return true
  return false
}

// ================================================================
// METHODS
// ================================================================

const getStatusLabel = (status: string): string => {
  const labels: Record<string, string> = {
    pending_bids: 'Pending',
    bidding: 'Price Collection',
    purchased: 'Purchased',
    arrived: 'Arrived at SDT'
  }
  return labels[status] || status
}

const getLowestBid = (request: PurchaseRequest): number => {
  if (!request.bids || request.bids.length === 0) return 0
  const sorted = getSortedBids(request)
  return sorted.length > 0 ? sorted[0].finalPrice || sorted[0].price * request.quantity : 0
}

const getHighestBid = (request: PurchaseRequest): number => {
  if (!request.bids || request.bids.length === 0) return 0
  const sorted = getSortedBids(request)
  return sorted.length > 0 ? sorted[sorted.length - 1].finalPrice || sorted[sorted.length - 1].price * request.quantity : 0
}

const getAverageBid = (request: PurchaseRequest): number => {
  const lowest = getLowestBid(request)
  const highest = getHighestBid(request)
  return (lowest + highest) / 2
}

const getWinnerBid = (request: PurchaseRequest): Bid | null => {
  if (!request.bids) return null
  return request.bids.find(b => b.isWinner) || null
}

const getSortedBids = (request: PurchaseRequest): Bid[] => {
  if (!request.bids) return []
  
  const winner = request.bids.find(b => b.isWinner)
  const others = request.bids.filter(b => !b.isWinner)
  
  const sortedOthers = [...others].sort((a, b) => {
    const finalA = a.finalPrice || a.price * request.quantity
    const finalB = b.finalPrice || b.price * request.quantity
    return finalA - finalB
  })
  
  return winner ? [winner, ...sortedOthers] : sortedOthers
}

const formatDate = (dateStr: string): string => {
  if (!dateStr) return 'N/A'
  const d = new Date(dateStr)
