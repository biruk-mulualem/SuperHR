<template>
  <div class="section-card">
    <!-- ==================== HEADER ==================== -->
    <div class="card-header">
      <div class="header-title">
        <h2>🏪 Local Purchase Follow-Up</h2>
        <span class="total-badge">{{ followUpRequests.length }} Requests</span>
      </div>
      <div class="header-actions">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            v-model="searchQuery"
            placeholder="Search by request #, item, or requester..."
            @input="onSearchChange"
          />
        </div>
        <button class="btn-get-request" @click="showImportModal = true">
          📥 Get Request
          <span class="btn-badge" v-if="availableRequestsCount > 0">{{ availableRequestsCount }}</span>
        </button>
        <button class="btn-export" @click="exportData">📊 Export</button>
        <button class="btn-refresh" @click="refreshData">🔄</button>
      </div>
    </div>

    <!-- ==================== FILTERS ==================== -->
    <div class="filter-bar">
      <select v-model="filterStatus" class="filter-select" @change="onFilterChange">
        <option value="all">All Status</option>
        <option value="pending_bids">Pending</option>
        <option value="bidding">Price Collection</option>
        <option value="purchased">Purchased</option>
        <option value="arrived">Arrived at SDT</option>
      </select>
      
      <select v-model="filterDepartment" class="filter-select" @change="onFilterChange">
        <option value="all">All Departments</option>
        <option v-for="dept in departments" :key="dept.id" :value="dept.id">
          {{ dept.name }}
        </option>
      </select>
      
      <button class="btn-clear-filters" @click="clearFilters" v-if="hasActiveFilters">
        ✕ Clear Filters
      </button>
    </div>

    <!-- ==================== STATS ==================== -->
    <div class="stats-row">
      <div class="stat-box">
        <span class="stat-number">{{ followUpRequests.length }}</span>
        <span class="stat-label">Total Requests</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">{{ pendingBids }}</span>
        <span class="stat-label">Pending</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">{{ activeBidding }}</span>
        <span class="stat-label">Price Collection</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">{{ purchasedCount }}</span>
        <span class="stat-label">Purchased</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">{{ arrivedCount }}</span>
        <span class="stat-label">Arrived at SDT</span>
      </div>
    </div>

    <!-- ==================== REQUESTS TABLE ==================== -->
    <div v-if="loading" class="loading-state">
      <div class="spinner"></div>
      <p>Loading requests...</p>
    </div>

    <div v-else class="table-wrapper">
      <table class="requests-table">
        <thead>
          <tr>
            <th class="col-expand"></th>
            <th class="col-code">Request #</th>
            <th class="col-item">Item</th>
            <th class="col-requester">Requested By</th>
            <th class="col-dept">Department</th>
            <th class="col-qty">Qty</th>
            <th class="col-date">Request Date</th>
            <th class="col-status">Status</th>
            <th class="col-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr v-if="filteredRequests.length === 0">
            <td colspan="9" class="empty-state">
              <div class="empty-content">
                <span class="empty-icon">📭</span>
                <p>No requests in follow-up</p>
                <button class="btn-get-request" @click="showImportModal = true">
                  📥 Get Request
                  <span class="btn-badge" v-if="availableRequestsCount > 0">{{ availableRequestsCount }}</span>
                </button>
              </div>
            </td>
          </tr>
          <template v-for="req in paginatedRequests" :key="req.id">
            <tr :class="{ 'expanded-row': expandedRow === req.id }">
              <td class="text-center">
                <button class="expand-btn" @click="toggleExpand(req.id)">
                  {{ expandedRow === req.id ? "▼" : "▶" }}
                </button>
              </td>
              <td class="code-cell">{{ req.requestNumber }}</td>
              <td>{{ req.itemName }}</td>
              <td>{{ req.requestedBy }}</td>
              <td>{{ req.department }}</td>
              <td>{{ req.quantity }} {{ req.uom }}</td>
              <td>{{ formatDate(req.requestDate) }}</td>
              <td>
                <span :class="['status-badge', req.status]">
                  {{ getStatusLabel(req.status) }}
                </span>
              </td>
              <td>
                <div class="action-buttons">
                  <button 
                    v-if="req.status === 'pending_bids' || req.status === 'bidding'" 
                    class="icon-btn bid-btn" 
                    @click="openBidModal(req)"
                    title="Add Price"
                    :disabled="isActionDisabled(req)"
                  >
                    💰
                  </button>
                  <button 
                    v-if="req.status === 'bidding'" 
                    class="icon-btn payment-btn" 
                    @click="openPaymentModal(req)"
                    title="Make Payment"
                    :disabled="isActionDisabled(req)"
                  >
                    💳
                  </button>
                </div>
              </td>
            </tr>

            <!-- ==================== EXPANDED DETAIL ROW ==================== -->
            <tr v-if="expandedRow === req.id" class="detail-expand-row">
              <td colspan="9">
                <div class="expand-details">
                  <div class="detail-container">
                    <!-- Top Row: Request Information + Timeline Side by Side -->
                    <div class="detail-row-two-cols">
                      <!-- Request Information -->
                      <div class="detail-card">
                        <div class="request-info-header">
                          <h4>📋 Request Information</h4>
                          <button 
                            class="btn-add-info" 
                            @click="openAddInfoModal(req)" 
                            title="Add additional info"
                            :disabled="isActionDisabled(req)"
                          >
                            ➕ Add Info
                          </button>
                        </div>
                        <div><span>Request Number</span><span class="value">{{ req.requestNumber }}</span></div>
                        <div><span>Item Name</span><span class="value">{{ req.itemName }}</span></div>
                        <div><span>Quantity</span><span class="value">{{ req.quantity }} {{ req.uom }}</span></div>
                        <div><span>Requested By</span><span class="value">{{ req.requestedBy }}</span></div>
                        <div><span>Department</span><span class="value">{{ req.department }}</span></div>
                        <div><span>Request Date</span><span class="value">{{ formatDate(req.requestDate) }}</span></div>
                        <div v-if="req.importedDate"><span>Added Date</span><span class="value">{{ formatDate(req.importedDate) }}</span></div>
                        <div><span>Status</span><span class="value"><span :class="['status-badge', req.status]">{{ getStatusLabel(req.status) }}</span></span></div>
                        <div v-if="req.description"><span>Description</span><span class="value">{{ req.description }}</span></div>
                        <div v-if="req.additionalInfo">
                          <span>Additional Info</span>
                          <span class="value">
                            <span class="additional-info-badge" @click="viewAdditionalInfo(req)">
                              📎 View Details
                            </span>
                          </span>
                        </div>
                      </div>

                      <!-- Timeline - Vertical Layout -->
                      <div class="detail-card">
                        <h4>📅 Timeline</h4>
                        <div class="timeline-vertical">
                          <div v-for="(event, index) in getTimeline(req)" :key="index" class="timeline-item-vertical">
                            <div class="timeline-line" v-if="index < getTimeline(req).length - 1"></div>
                            <div class="timeline-content-vertical">
                              <div class="timeline-dot-vertical" :class="event.status"></div>
                              <div class="timeline-body">
                                <div class="timeline-date-vertical">{{ formatDate(event.date) }}</div>
                                <div class="timeline-title-vertical">{{ event.title }}</div>
                                <div class="timeline-description-vertical">{{ event.description }}</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Prices Section -->
                    <div class="detail-card">
                      <!-- Actions at the top -->
                      <div class="detail-actions">
                        <button 
                          v-if="req.status === 'pending_bids' || req.status === 'bidding'" 
                          class="btn-bid-detail" 
                          @click="openBidModal(req)"
                          :disabled="isActionDisabled(req)"
                        >
                          💰 Add Price
                        </button>
                        <button 
                          v-if="req.status === 'bidding'" 
                          class="btn-payment-detail" 
                          @click="openPaymentModal(req)"
                          :disabled="isActionDisabled(req)"
                        >
                          💳 Make Payment
                        </button>
                        <button 
                          v-if="req.status === 'purchased'" 
                          class="btn-arrive-detail" 
                          @click="openArrivedModal(req)"
                          :disabled="isDisabled(req)"
                        >
                          📦 Arrived at SDT
                        </button>
                      </div>

                      <!-- Price Header -->
                      <div class="price-header">
                        <h4>💰 Prices ({{ getSortedBids(req).length }})</h4>
                      </div>

                      <!-- Summary - Based on Final Price -->
                      <div class="bid-summary-detail" v-if="getSortedBids(req).length > 0">
                        <div class="summary-item">
                          <span class="summary-label">Lowest</span>
                          <strong class="summary-value">ETB {{ getLowestBid(req).toFixed(2) }}</strong>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item">
                          <span class="summary-label">Highest</span>
                          <strong class="summary-value">ETB {{ getHighestBid(req).toFixed(2) }}</strong>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item">
                          <span class="summary-label">Average</span>
                          <strong class="summary-value">ETB {{ getAverageBid(req).toFixed(2) }}</strong>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item winner-summary" v-if="getWinnerBid(req)">
                          <span class="summary-label">🏆 Winner</span>
                          <strong class="summary-value winner-name">{{ getWinnerBid(req).employee }}</strong>
                          <span class="winner-price">ETB {{ (getWinnerBid(req).finalPrice || getWinnerBid(req).price * req.quantity).toFixed(2) }}</span>
                        </div>
                      </div>

                      <!-- Price Table -->
                      <div v-if="getSortedBids(req).length > 0">
                        <table class="bids-detail-table">
                          <thead>
                            <tr>
                              <th>Rank</th>
                              <th>Employee</th>
                              <th>Unit Price</th>
                              <th>Total Price</th>
                              <th>Discount</th>
                              <th>Final Price</th>
                              <th>Submitted</th>
                              <th>Status</th>
                              <th style="width: 80px;">Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr 
                              v-for="(bid, index) in getSortedBids(req)" 
                              :key="bid.id" 
                              :class="{ 
                                'winner-row': bid.isWinner,
                                'not-match': bid.matchesRequirement === false && !bid.isWinner,
                                'match-row': bid.matchesRequirement === true && !bid.isWinner
                              }"
                            >
                              <td class="rank-cell">
                                <span v-if="bid.isWinner" class="rank-winner">🏆</span>
                                <span v-else class="rank-number">#{{ index + 1 }}</span>
                              </td>
                              <td>{{ bid.employee }}</td>
                              <td class="amount">ETB {{ bid.price.toFixed(2) }}</td>
                              <td class="amount">ETB {{ (bid.price * req.quantity).toFixed(2) }}</td>
                              <td class="amount">ETB {{ (bid.discount || 0).toFixed(2) }}</td>
                              <td class="amount final-price">ETB {{ (bid.finalPrice || bid.price * req.quantity).toFixed(2) }}</td>
                              <td>{{ formatDate(bid.submittedDate) }}</td>
                              <td>
                                <span v-if="bid.isWinner" class="winner-badge">🏆 Winner</span>
                                <span v-else-if="bid.matchesRequirement === false" class="not-match-badge" :title="bid.remark">
                                  ❌ Not Match
                                </span>
                                <span v-else-if="bid.matchesRequirement === true" class="match-badge">
                                  ✅ Match
                                </span>
                                <span v-else-if="bid.status === 'pending'" class="bid-status pending">⏳ Pending</span>
                                <span v-else-if="bid.status === 'rejected'" class="bid-status rejected">❌ Rejected</span>
                                <span v-else class="bid-status">{{ bid.status }}</span>
                              </td>
                              <td>
                                <div class="action-cell">
                                  <button 
                                    class="btn-edit-price" 
                                    @click="openEditModal(req, bid)"
                                    title="Edit this price"
                                    :disabled="isActionDisabled(req)"
                                  >
                                    ✏️
                                  </button>
                                  <button 
                                    class="btn-remove-price" 
                                    @click="openRemoveModal(req, bid)"
                                    title="Remove this price"
                                    :disabled="isActionDisabled(req)"
                                  >
                                    ✕
                                  </button>
                                </div>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                      <div v-else class="no-data">No prices submitted yet</div>
                    </div>

                    <!-- Payment Details -->
                    <div class="detail-card" v-if="req.paymentDetails">
                      <h4>💳 Payment Details</h4>
                      <div><span>Winning Sales Person</span><span class="value">{{ req.paymentDetails.employee }}</span></div>
                      <div><span>Final Amount Paid</span><span class="value amount final-amount">ETB {{ req.paymentDetails.finalAmount.toFixed(2) }}</span></div>
                      <div><span>Paid By</span><span class="value">{{ req.paymentDetails.paidBy }}</span></div>
                      <div><span>Transfer Number</span><span class="value transfer-number">{{ req.paymentDetails.transferNumber }}</span></div>
                      <div><span>Bank</span><span class="value">{{ req.paymentDetails.bank }}</span></div>
                      <div><span>Payment Date</span><span class="value">{{ formatDate(req.paymentDetails.paymentDate) }}</span></div>
                      <div v-if="req.paymentDetails.remark"><span>Remark</span><span class="value">{{ req.paymentDetails.remark }}</span></div>
                    </div>

                    <!-- Arrival Details -->
                    <div class="detail-card" v-if="req.arrivalDetails">
                      <h4>📦 Arrival Details</h4>
                      <div><span>Arrived at SDT</span><span class="value">{{ formatDate(req.arrivalDetails.arrivedDate) }}</span></div>
                      <div v-if="req.arrivalDetails.remark"><span>Remark</span><span class="value">{{ req.arrivalDetails.remark }}</span></div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- ==================== PAGINATION ==================== -->
    <div class="pagination" v-if="totalItems > 0">
      <button class="page-btn" :disabled="currentPage === 1" @click="changePage(currentPage - 1)">
        ← Previous
      </button>
      <span class="page-info">Page {{ currentPage }} of {{ totalPages }}</span>
      <button class="page-btn" :disabled="currentPage === totalPages" @click="changePage(currentPage + 1)">
        Next →
      </button>
      <select v-model="pageSize" @change="changePageSize" class="limit-select">
        <option :value="5">5 per page</option>
        <option :value="10">10 per page</option>
        <option :value="20">20 per page</option>
        <option :value="50">50 per page</option>
      </select>
    </div>

    <!-- ==================== GET REQUEST MODAL ==================== -->
    <div v-if="showImportModal" class="modal-overlay" @click.self="showImportModal = false">
      <div class="modal-container">
        <div class="modal-header">
          <h3>📥 Get Approved Purchase Requests</h3>
          <button class="modal-close" @click="showImportModal = false">✕</button>
        </div>
        <div class="modal-body">
          <div class="import-info">
            <p>These are approved local purchase requests waiting to be added to your follow-up.</p>
            <div class="import-stats">
              <span>Total Available: <strong>{{ availableRequests.length }}</strong></span>
              <span>Pending to Add: <strong>{{ availableRequests.filter(r => !r.imported).length }}</strong></span>
            </div>
          </div>
          <table class="import-table">
            <thead>
              <tr>
                <th style="width: 40px;"><input type="checkbox" v-model="selectAll" @change="toggleSelectAll" /></th>
                <th>Request #</th>
                <th>Item</th>
                <th>Requested By</th>
                <th>Department</th>
                <th>Qty</th>
                <th>Request Date</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr v-if="availableRequests.length === 0">
                <td colspan="8" class="empty">No pending requests to add</td>
              </tr>
              <tr v-for="req in availableRequests" :key="req.id" :class="{ 'imported': req.imported }">
                <td><input type="checkbox" v-model="req.selected" :disabled="req.imported" /></td>
                <td class="code-cell">{{ req.requestNumber }}</td>
                <td>{{ req.itemName }}</td>
                <td>{{ req.requestedBy }}</td>
                <td>{{ req.department }}</td>
                <td>{{ req.quantity }} {{ req.uom }}</td>
                <td>{{ formatDate(req.requestDate) }}</td>
                <td>
                  <span v-if="req.imported" class="imported-badge">✅ Added</span>
                  <span v-else :class="['status-badge', 'approved']">Approved</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" @click="showImportModal = false">Cancel</button>
          <button class="btn-primary" @click="importSelected" :disabled="selectedForImport.length === 0">
            Add Selected ({{ selectedForImport.length }})
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== PRICE MODAL ==================== -->
    <div v-if="showBidModal" class="modal-overlay" @click.self="showBidModal = false">
      <div class="modal-container small-modal">
        <div class="modal-header">
          <h3>💰 Submit Price - {{ bidRequest?.requestNumber }}</h3>
          <button class="modal-close" @click="showBidModal = false">✕</button>
        </div>
        <div class="modal-body">
          <div class="info-box">
            <p><strong>Item:</strong> {{ bidRequest?.itemName }}</p>
            <p><strong>Quantity:</strong> {{ bidRequest?.quantity }} {{ bidRequest?.uom }}</p>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Sales Person *</label>
              <select v-model="newBid.employee" class="form-input">
                <option value="">Select Sales Person</option>
                <option v-for="emp in employees" :key="emp.id" :value="emp.name">
                  {{ emp.name }} - {{ emp.department }}
                </option>
              </select>
            </div>
            <div class="form-group">
              <label>Unit Price (ETB) *</label>
              <input type="number" v-model="newBid.price" class="form-input" min="0" step="0.01" @input="calculateTotal" />
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Total Price (ETB)</label>
              <input type="text" :value="newBid.totalPrice.toFixed(2)" class="form-input" disabled readonly />
              <span class="hint">Unit Price × Quantity</span>
            </div>
            <div class="form-group">
              <label>Discount (ETB)</label>
              <input type="number" v-model="newBid.discount" class="form-input" min="0" step="0.01" @input="calculateFinalPrice" />
            </div>
          </div>
          
          <div class="form-group">
            <label>Final Price (ETB)</label>
            <input type="text" :value="newBid.finalPrice.toFixed(2)" class="form-input final-amount" disabled readonly />
            <span class="hint">Final price after discount</span>
          </div>
          
          <div class="form-group">
            <label>Does this match the requirement?</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" v-model="newBid.matchesRequirement" :value="true" />
                ✅ Yes - Match
              </label>
              <label class="radio-label">
                <input type="radio" v-model="newBid.matchesRequirement" :value="false" />
                ❌ No - Not Match
              </label>
            </div>
          </div>
          
          <div class="form-group" v-if="newBid.matchesRequirement === false">
            <label>Reason / What's different? *</label>
            <textarea v-model="newBid.remark" class="form-textarea" rows="2" placeholder="Why doesn't this match the requirement?" />
          </div>
          
          <div class="form-group">
            <label>Additional Notes</label>
            <textarea v-model="newBid.notes" class="form-textarea" rows="2" placeholder="Additional notes..." />
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" @click="showBidModal = false">Cancel</button>
          <button class="btn-primary" @click="submitBid" :disabled="!isBidValid">Submit Price</button>
        </div>
      </div>
    </div>

    <!-- ==================== EDIT MODAL ==================== -->
    <div v-if="showEditModal" class="modal-overlay" @click.self="showEditModal = false">
      <div class="modal-container small-modal">
        <div class="modal-header">
          <h3>✏️ Edit Price - {{ editTarget?.request.requestNumber }}</h3>
          <button class="modal-close" @click="showEditModal = false">✕</button>
        </div>
        <div class="modal-body">
          <div class="info-box">
            <p><strong>Employee:</strong> {{ editTarget?.bid.employee }}</p>
            <p><strong>Item:</strong> {{ editTarget?.request.itemName }}</p>
            <p><strong>Quantity:</strong> {{ editTarget?.request.quantity }} {{ editTarget?.request.uom }}</p>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Unit Price (ETB) *</label>
              <input type="number" v-model="editData.price" class="form-input" min="0" step="0.01" @input="calculateEditTotal" />
            </div>
            <div class="form-group">
              <label>Total Price (ETB)</label>
              <input type="text" :value="editData.totalPrice.toFixed(2)" class="form-input" disabled readonly />
              <span class="hint">Unit Price × Quantity</span>
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Discount (ETB)</label>
              <input type="number" v-model="editData.discount" class="form-input" min="0" step="0.01" @input="calculateEditFinal" />
            </div>
            <div class="form-group">
              <label>Final Price (ETB)</label>
              <input type="text" :value="editData.finalPrice.toFixed(2)" class="form-input final-amount" disabled readonly />
            </div>
          </div>
          
          <div class="form-group">
            <label>Does this match the requirement?</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" v-model="editData.matchesRequirement" :value="true" />
                ✅ Yes - Match
              </label>
              <label class="radio-label">
                <input type="radio" v-model="editData.matchesRequirement" :value="false" />
                ❌ No - Not Match
              </label>
            </div>
          </div>
          
          <div class="form-group" v-if="editData.matchesRequirement === false">
            <label>Reason / What's different? *</label>
            <textarea v-model="editData.remark" class="form-textarea" rows="2" placeholder="Why doesn't this match the requirement?" />
          </div>
          
          <div class="form-group">
            <label>Additional Notes</label>
            <textarea v-model="editData.notes" class="form-textarea" rows="2" placeholder="Additional notes..." />
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" @click="showEditModal = false">Cancel</button>
          <button class="btn-primary" @click="confirmEdit" :disabled="!isEditValid">Update Price</button>
        </div>
      </div>
    </div>

    <!-- ==================== REMOVE MODAL ==================== -->
    <div v-if="showRemoveModal" class="modal-overlay" @click.self="showRemoveModal = false">
      <div class="modal-container small-modal">
        <div class="modal-header">
          <h3>⚠️ Remove Price</h3>
          <button class="modal-close" @click="showRemoveModal = false">✕</button>
        </div>
        <div class="modal-body">
          <div class="remove-info">
