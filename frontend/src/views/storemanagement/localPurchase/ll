// WATCHERS & LIFECYCLE
// ================================================================

watch([filterStatus, filterDepartment, searchQuery], () => {
  currentPage.value = 1
})

watch(pageSize, () => { currentPage.value = 1 })

onMounted(() => {})
</script>

