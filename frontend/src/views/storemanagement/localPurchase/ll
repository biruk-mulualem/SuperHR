const calculateTotal = () => {
  if (bidRequest.value) {
    newBid.value.totalPrice = newBid.value.price * bidRequest.value.quantity
    calculateFinalPrice()
  }
}

const calculateFinalPrice = () => {
  const total = newBid.value.totalPrice || (newBid.value.price * (bidRequest.value?.quantity || 1))
  const discount = newBid.value.discount || 0
  newBid.value.finalPrice = Math.max(0, total - discount)
}

const calculateEditTotal = () => {
  if (editTarget.value) {
    editData.value.totalPrice = editData.value.price * editTarget.value.request.quantity
    calculateEditFinal()
  }
}

const calculateEditFinal = () => {
  const total = editData.value.totalPrice || (editData.value.price * (editTarget.value?.request.quantity || 1))
  const discount = editData.value.discount || 0
  editData.value.finalPrice = Math.max(0, total - discount)
}

