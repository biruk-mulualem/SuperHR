// ================================================================
// BID/PRICE METHODS
// ================================================================

const openBidModal = (request: PurchaseRequest) => {
  if (isActionDisabled(request)) return
  bidRequest.value = request
  newBid.value = { 
    employee: '', 
    price: 0, 
    totalPrice: 0,
    discount: 0,
    finalPrice: 0,
    matchesRequirement: true,
    remark: '',
    notes: '' 
  }
  showBidModal.value = true
}

const submitBid = () => {
  if (!bidRequest.value) return
  if (!isBidValid.value) {
    alert('Please fill in all required fields')
    return
  }
  
  const request = allRequests.value.find(r => r.id === bidRequest.value?.id)
  if (request) {
    if (!request.bids) request.bids = []
    
    const totalPrice = newBid.value.price * request.quantity
    const discount = newBid.value.discount || 0
    const finalPrice = Math.max(0, totalPrice - discount)
    
    const matchingBids = request.bids.filter(b => b.matchesRequirement === true)
    const isLowestMatch = matchingBids.length === 0 || 
      newBid.value.price < Math.min(...matchingBids.map(b => b.price))
    
    const shouldBeWinner = newBid.value.matchesRequirement === true && isLowestMatch
    
    const newBidEntry: Bid = {
      id: Date.now(),
      employee: newBid.value.employee,
      price: newBid.value.price,
      totalPrice: totalPrice,
      discount: discount,
      finalPrice: finalPrice,
      submittedDate: new Date().toISOString().split('T')[0],
      status: shouldBeWinner ? 'accepted' : 'pending',
      isWinner: shouldBeWinner,
      matchesRequirement: newBid.value.matchesRequirement,
      remark: newBid.value.matchesRequirement === false ? newBid.value.remark : undefined,
      notes: newBid.value.notes
    }
    
    request.bids.push(newBidEntry)
    
    if (shouldBeWinner) {
      request.bids.forEach(b => {
        if (b.id !== newBidEntry.id) {
          b.isWinner = false
          b.status = 'rejected'
        }
      })
    }
    
    request.status = 'bidding'
  }
  
  showBidModal.value = false
  bidRequest.value = null
}

// ================================================================
// EDIT METHODS
// ================================================================

const openEditModal = (request: PurchaseRequest, bid: Bid) => {
  if (isActionDisabled(request)) return
  editTarget.value = { request, bid }
  editData.value = {
    price: bid.price,
    totalPrice: bid.totalPrice || bid.price * request.quantity,
    discount: bid.discount || 0,
    finalPrice: bid.finalPrice || bid.price * request.quantity,
    matchesRequirement: bid.matchesRequirement !== false,
    remark: bid.remark || '',
    notes: bid.notes || ''
  }
  showEditModal.value = true
}

const confirmEdit = () => {
  if (!editTarget.value) return
  if (!isEditValid.value) {
    alert('Please fill in all required fields')
    return
  }
  
  const { request, bid } = editTarget.value
  const index = allRequests.value.findIndex(r => r.id === request.id)
  
  if (index !== -1) {
    const req = allRequests.value[index]
    if (req.bids) {
      const bidIndex = req.bids.findIndex(b => b.id === bid.id)
      if (bidIndex !== -1) {
        const totalPrice = editData.value.price * request.quantity
        const discount = editData.value.discount || 0
        const finalPrice = Math.max(0, totalPrice - discount)
        
        const otherMatchingBids = req.bids.filter((b, idx) => 
          b.matchesRequirement === true && idx !== bidIndex
        )
        const isLowestMatch = editData.value.matchesRequirement === true && 
          (otherMatchingBids.length === 0 || 
            editData.value.price < Math.min(...otherMatchingBids.map(b => b.price)))
        
        const wasWinner = bid.isWinner
        
        req.bids[bidIndex] = {
          ...req.bids[bidIndex],
          price: editData.value.price,
          totalPrice: totalPrice,
          discount: discount,
          finalPrice: finalPrice,
          matchesRequirement: editData.value.matchesRequirement,
          remark: editData.value.matchesRequirement === false ? editData.value.remark : undefined,
          notes: editData.value.notes,
          isWinner: wasWinner && editData.value.matchesRequirement === true ? true : false,
          status: wasWinner && editData.value.matchesRequirement === true ? 'accepted' : 'pending'
        }
        
        if (wasWinner && editData.value.matchesRequirement === false) {
          const matchingBids = req.bids.filter(b => b.matchesRequirement === true)
          if (matchingBids.length > 0) {
            const lowestMatch = matchingBids.reduce((a, b) => a.price < b.price ? a : b)
            lowestMatch.isWinner = true
            lowestMatch.status = 'accepted'
          } else {
            req.bids.forEach(b => {
              b.isWinner = false
              b.status = 'pending'
            })
          }
        }
        
        if (editData.value.matchesRequirement === true && isLowestMatch) {
          req.bids.forEach(b => {
            if (b.id !== req.bids[bidIndex].id) {
              b.isWinner = false
              b.status = 'rejected'
            }
          })
          req.bids[bidIndex].isWinner = true
          req.bids[bidIndex].status = 'accepted'
        }
      }
    }
  }
  
  showEditModal.value = false
  editTarget.value = null
}

// ================================================================
// REMOVE METHODS
// ================================================================

const openRemoveModal = (request: PurchaseRequest, bid: Bid) => {
  if (isActionDisabled(request)) return
  removeTarget.value = { request, bid }
  removeRemark.value = ''
  showRemoveModal.value = true
}

const confirmRemove = () => {
  if (!removeTarget.value) return
  
  const { request, bid } = removeTarget.value
  const index = allRequests.value.findIndex(r => r.id === request.id)
  
  if (index !== -1) {
    const req = allRequests.value[index]
    if (req.bids) {
      req.bids = req.bids.filter(b => b.id !== bid.id)
      
      if (bid.isWinner) {
        const matchingBids = req.bids.filter(b => b.matchesRequirement === true)
        if (matchingBids.length > 0) {
          const lowestMatch = matchingBids.reduce((a, b) => a.price < b.price ? a : b)
          lowestMatch.isWinner = true
          lowestMatch.status = 'accepted'
        } else {
          if (req.bids.length > 0) {
            const lowestBid = req.bids.reduce((a, b) => a.price < b.price ? a : b)
            lowestBid.isWinner = true
            lowestBid.status = 'accepted'
          }
        }
      }
      
      if (req.bids.length === 0) {
        req.status = 'pending_bids'
        req.paymentDetails = undefined
        req.arrivalDetails = undefined
      }
    }
  }
  
  showRemoveModal.value = false
  removeTarget.value = null
  removeRemark.value = ''
}

// ================================================================
// PAYMENT METHODS
// ================================================================

const openPaymentModal = (request: PurchaseRequest) => {
  if (isActionDisabled(request)) return
  paymentRequest.value = request
  
  const winnerBid = getWinnerBid(request)
  if (winnerBid) {
    paymentDetails.value.employee = winnerBid.employee
    paymentDetails.value.finalAmount = winnerBid.finalPrice || winnerBid.price * request.quantity
  } else {
    const sortedBids = getSortedBids(request)
    if (sortedBids.length > 0) {
      const lowestBid = sortedBids[0]
      paymentDetails.value.employee = lowestBid.employee
      paymentDetails.value.finalAmount = lowestBid.finalPrice || lowestBid.price * request.quantity
    }
  }
  
  paymentDetails.value.paidBy = ''
  paymentDetails.value.transferNumber = ''
  paymentDetails.value.bank = 'Commercial Bank of Ethiopia'
  paymentDetails.value.paymentDate = new Date().toISOString().split('T')[0]
  paymentDetails.value.remark = ''
  
  showPaymentModal.value = true
}

const confirmPayment = () => {
  if (!paymentRequest.value) return
  if (!isPaymentValid.value) {
    alert('Please fill in all required fields')
    return
  }
  
  const request = allRequests.value.find(r => r.id === paymentRequest.value?.id)
  if (request) {
    request.bids?.forEach(b => {
      b.isWinner = b.employee === paymentDetails.value.employee
      b.status = b.employee === paymentDetails.value.employee ? 'accepted' : 'rejected'
    })
    
    request.paymentDetails = {
      employee: paymentDetails.value.employee,
      finalAmount: paymentDetails.value.finalAmount,
      paidBy: paymentDetails.value.paidBy,
      transferNumber: paymentDetails.value.transferNumber,
      bank: paymentDetails.value.bank,
      paymentDate: paymentDetails.value.paymentDate,
      remark: paymentDetails.value.remark
    }
    
    request.status = 'purchased'
  }
  
  showPaymentModal.value = false
  paymentRequest.value = null
}

// ================================================================
// ARRIVED METHODS
// ================================================================

const openArrivedModal = (request: PurchaseRequest) => {
  if (request.status !== 'purchased') {
    alert('Only purchased items can be marked as arrived.')
    return
  }
  
  if (request.status === 'arrived') return
  
  arrivedRequest.value = request
  arrivedRemark.value = ''
  showArrivedModal.value = true
}

const confirmArrived = () => {
  if (!arrivedRequest.value) return
  
  const index = allRequests.value.findIndex(r => r.id === arrivedRequest.value?.id)
  if (index !== -1) {
    allRequests.value[index].status = 'arrived'
    allRequests.value[index].arrivalDetails = {
      arrivedDate: new Date().toISOString().split('T')[0],
      remark: arrivedRemark.value || 'Items arrived at SDT warehouse'
    }
  }
  
  showArrivedModal.value = false
  arrivedRequest.value = null
  arrivedRemark.value = ''
}

// ================================================================
// EXPORT
// ================================================================

const exportData = () => {
  const headers = ['Request #', 'Item', 'Quantity', 'UOM', 'Requested By', 'Department', 'Request Date', 'Status', 'Prices', 'Lowest Price']
  const rows = filteredRequests.value.map(req => [
    req.requestNumber,
    req.itemName,
    req.quantity,
    req.uom,
    req.requestedBy,
    req.department,
    formatDate(req.requestDate),
    getStatusLabel(req.status),
    req.bids?.length || 0,
    getLowestBid(req).toFixed(2)
  ])
  
  const csv = [headers.join(','), ...rows.map(row => row.join(','))].join('\n')
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = `local_purchase_followup_${new Date().toISOString().split('T')[0]}.csv`
  document.body.appendChild(a)
  a.click()
  document.body.removeChild(a)
  URL.revokeObjectURL(url)
}

