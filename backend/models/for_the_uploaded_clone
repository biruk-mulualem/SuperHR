-- ================================================================
-- PRINT OVERRIDES — Full Setup
-- Stores per-request print form customizations
-- ================================================================

-- ----------------------------------------------------------------
-- 1. TABLE
-- ----------------------------------------------------------------
CREATE TABLE IF NOT EXISTS print_overrides (
  id                  SERIAL PRIMARY KEY,

  -- ----- Relationships -----
  request_id          INTEGER NOT NULL
                        REFERENCES item_requests(id)
                        ON UPDATE CASCADE
                        ON DELETE CASCADE,

  user_id             INTEGER NULL
                        REFERENCES users(user_id)
                        ON UPDATE CASCADE
                        ON DELETE SET NULL,

  updated_by          INTEGER NULL
                        REFERENCES users(user_id)
                        ON UPDATE CASCADE
                        ON DELETE SET NULL,

  -- ----- Editable fields -----
  department          VARCHAR(255)  NULL,
  approved_by_name    VARCHAR(255)  NULL,
  override_date       DATE          NULL,
  custom_header       TEXT          NULL,

  -- ----- JSON blobs -----
  section_visibility  JSONB         NULL,
  columns_config      JSONB         NULL,
  custom_cells        JSONB         NULL,

  -- ----- Meta -----
  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ----------------------------------------------------------------
-- 2. INDEXES
-- ----------------------------------------------------------------

-- Per-user override — unique when user_id is set
CREATE UNIQUE INDEX IF NOT EXISTS print_overrides_request_user_unique
  ON print_overrides (request_id, user_id)
  WHERE user_id IS NOT NULL;

-- Shared override — unique when user_id IS NULL
CREATE UNIQUE INDEX IF NOT EXISTS print_overrides_request_shared_unique
  ON print_overrides (request_id)
  WHERE user_id IS NULL;

-- Fast lookup by request
CREATE INDEX IF NOT EXISTS print_overrides_request_id_idx
  ON print_overrides (request_id);

-- Fast lookup by user
CREATE INDEX IF NOT EXISTS print_overrides_user_id_idx
  ON print_overrides (user_id);

-- ----------------------------------------------------------------
-- 3. AUTO-UPDATE updated_at TRIGGER
-- ----------------------------------------------------------------

CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_print_overrides_updated_at ON print_overrides;
CREATE TRIGGER trg_print_overrides_updated_at
  BEFORE UPDATE ON print_overrides
  FOR EACH ROW
  EXECUTE FUNCTION set_updated_at();

-- ----------------------------------------------------------------
-- 4. OPTIONAL JSONB SHAPE GUARDS
-- ----------------------------------------------------------------

ALTER TABLE print_overrides
  DROP CONSTRAINT IF EXISTS chk_section_visibility_json;
ALTER TABLE print_overrides
  ADD CONSTRAINT chk_section_visibility_json
  CHECK (
    section_visibility IS NULL
    OR jsonb_typeof(section_visibility) = 'object'
  );

ALTER TABLE print_overrides
  DROP CONSTRAINT IF EXISTS chk_columns_config_array;
ALTER TABLE print_overrides
  ADD CONSTRAINT chk_columns_config_array
  CHECK (
    columns_config IS NULL
    OR jsonb_typeof(columns_config) = 'array'
  );

ALTER TABLE print_overrides
  DROP CONSTRAINT IF EXISTS chk_custom_cells_object;
ALTER TABLE print_overrides
  ADD CONSTRAINT chk_custom_cells_object
  CHECK (
    custom_cells IS NULL
    OR jsonb_typeof(custom_cells) = 'object'
  );

-- ----------------------------------------------------------------
-- 5. VERIFY
-- ----------------------------------------------------------------

SELECT column_name, data_type, is_nullable, column_default
FROM information_schema.columns
WHERE table_name = 'print_overrides'
ORDER BY ordinal_position;


ALTER TABLE print_overrides
  ADD COLUMN IF NOT EXISTS page_snapshot JSONB DEFAULT NULL;














-- ============================================================
-- item_relationships
-- Pairs two items that refer to the same physical thing in
-- different units (e.g. SDT0001 DRUM <-> SDT0002 KG).
-- ============================================================

CREATE TABLE item_relationships (
  id                  BIGSERIAL PRIMARY KEY,

  relationship_code   VARCHAR(20) NOT NULL,

  item_a_id           INTEGER NOT NULL
                        REFERENCES items(id)
                        ON UPDATE CASCADE
                        ON DELETE RESTRICT,

  item_b_id           INTEGER NOT NULL
                        REFERENCES items(id)
                        ON UPDATE CASCADE
                        ON DELETE RESTRICT,

  remark              VARCHAR(255),

  status              VARCHAR(10) NOT NULL DEFAULT 'Active'
                        CONSTRAINT chk_item_relationships_status
                        CHECK (status IN ('Active', 'Inactive')),

  -- FK -> users.user_id  (User model: userId -> field 'user_id')
  created_by          INTEGER
                        REFERENCES users(user_id)
                        ON UPDATE CASCADE
                        ON DELETE SET NULL,

  updated_by          INTEGER
                        REFERENCES users(user_id)
                        ON UPDATE CASCADE
                        ON DELETE SET NULL,

  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  CONSTRAINT chk_item_relationships_distinct
    CHECK (item_a_id <> item_b_id)
);

-- Unique relationship codes
CREATE UNIQUE INDEX uq_item_relationships_code
  ON item_relationships (relationship_code);

-- Symmetric uniqueness: (A=1,B=2) and (A=2,B=1) are the same pair.
CREATE UNIQUE INDEX uq_item_relationships_pair
  ON item_relationships (
    LEAST(item_a_id, item_b_id),
    GREATEST(item_a_id, item_b_id)
  );

-- Lookup indexes
CREATE INDEX idx_item_relationships_a
  ON item_relationships (item_a_id);
CREATE INDEX idx_item_relationships_b
  ON item_relationships (item_b_id);
CREATE INDEX idx_item_relationships_status
  ON item_relationships (status);

-- Keep updated_at fresh on UPDATE
CREATE OR REPLACE FUNCTION set_updated_at_item_relationships()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_item_relationships_updated_at
  BEFORE UPDATE ON item_relationships
  FOR EACH ROW
  EXECUTE FUNCTION set_updated_at_item_relationships();


