-- Add stage column to track which stage each notification belongs to
ALTER TABLE request_notifications 
ADD COLUMN stage VARCHAR(30) DEFAULT 'supplying_store';

-- Existing notifications belong to the supplying stage (preserves current behavior)
UPDATE request_notifications SET stage = 'supplying_store' WHERE stage IS NULL;

-- Index for fast lookups by stage
CREATE INDEX idx_notifications_request_stage 
ON request_notifications(request_id, stage);

-- Index for filtering by status + stage
CREATE INDEX idx_notifications_stage_status 
ON request_notifications(stage, status);