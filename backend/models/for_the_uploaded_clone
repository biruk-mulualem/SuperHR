-- ============================================================================
-- POSTS FEATURE — 7 TABLES + ALL INDEXES + FOREIGN KEYS
-- Run order matters. Everything is included in this single script.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. post_groups
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_groups (
  id            BIGSERIAL    PRIMARY KEY,
  name          VARCHAR(255) NOT NULL,
  description   TEXT,
  emoji         VARCHAR(16)  DEFAULT '💬',
  accent        VARCHAR(16)  DEFAULT '#8B5CF6',
  status        VARCHAR(16)  NOT NULL DEFAULT 'active',
  created_by    INTEGER      NOT NULL REFERENCES users(user_id),
  last_activity TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  deleted_at    TIMESTAMPTZ,
  created_at    TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  updated_at    TIMESTAMPTZ  NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_post_groups_status        ON post_groups(status, deleted_at);
CREATE INDEX IF NOT EXISTS idx_post_groups_created_by    ON post_groups(created_by);
CREATE INDEX IF NOT EXISTS idx_post_groups_last_activity ON post_groups(last_activity DESC);


-- ----------------------------------------------------------------------------
-- 2. post_group_members
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_group_members (
  id          BIGSERIAL    PRIMARY KEY,
  group_id    BIGINT       NOT NULL REFERENCES post_groups(id) ON DELETE CASCADE,
  user_id     INTEGER      NOT NULL REFERENCES users(user_id),
  role        VARCHAR(16)  NOT NULL DEFAULT 'member',
  status      VARCHAR(16)  NOT NULL DEFAULT 'pending',
  invited_by  INTEGER      REFERENCES users(user_id),
  invited_at  TIMESTAMPTZ,
  joined_at   TIMESTAMPTZ,
  created_at  TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  updated_at  TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  CONSTRAINT uniq_post_group_member UNIQUE (group_id, user_id)
);

CREATE INDEX IF NOT EXISTS idx_pgm_user   ON post_group_members(user_id);
CREATE INDEX IF NOT EXISTS idx_pgm_group  ON post_group_members(group_id);
CREATE INDEX IF NOT EXISTS idx_pgm_status ON post_group_members(group_id, status);


-- ----------------------------------------------------------------------------
-- 3. post_posts
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_posts (
  id           BIGSERIAL    PRIMARY KEY,
  group_id     BIGINT       NOT NULL REFERENCES post_groups(id) ON DELETE CASCADE,
  author_id    INTEGER      NOT NULL REFERENCES users(user_id),
  title        VARCHAR(255) NOT NULL,
  body         TEXT,
  status       VARCHAR(16)  NOT NULL DEFAULT 'pending',
  review_note  TEXT,
  reviewed_by  INTEGER      REFERENCES users(user_id),
  reviewed_at  TIMESTAMPTZ,
  created_at   TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  updated_at   TIMESTAMPTZ  NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_posts_group_status ON post_posts(group_id, status);
CREATE INDEX IF NOT EXISTS idx_posts_author       ON post_posts(author_id);
CREATE INDEX IF NOT EXISTS idx_posts_created_at   ON post_posts(created_at DESC);


-- ----------------------------------------------------------------------------
-- 4. post_images
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_images (
  id                BIGSERIAL    PRIMARY KEY,
  post_id           BIGINT       NOT NULL REFERENCES post_posts(id) ON DELETE CASCADE,
  url               VARCHAR(512) NOT NULL,
  order_index       INTEGER      NOT NULL DEFAULT 0,
  annotated_from_id BIGINT       REFERENCES post_images(id) ON DELETE SET NULL,
  created_at        TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  updated_at        TIMESTAMPTZ  NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_post_images_post     ON post_images(post_id);
CREATE INDEX IF NOT EXISTS idx_post_images_original ON post_images(annotated_from_id);


-- ----------------------------------------------------------------------------
-- 5. post_comments
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_comments (
  id         BIGSERIAL   PRIMARY KEY,
  post_id    BIGINT      NOT NULL REFERENCES post_posts(id) ON DELETE CASCADE,
  author_id  INTEGER     NOT NULL REFERENCES users(user_id),
  body       TEXT        NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_post_comments_post   ON post_comments(post_id);
CREATE INDEX IF NOT EXISTS idx_post_comments_author ON post_comments(author_id);


-- ----------------------------------------------------------------------------
-- 6. post_reads
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_reads (
  id       BIGSERIAL   PRIMARY KEY,
  post_id  BIGINT      NOT NULL REFERENCES post_posts(id) ON DELETE CASCADE,
  user_id  INTEGER     NOT NULL REFERENCES users(user_id),
  read_at  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  CONSTRAINT uniq_post_read UNIQUE (post_id, user_id)
);

CREATE INDEX IF NOT EXISTS idx_post_reads_user ON post_reads(user_id);
CREATE INDEX IF NOT EXISTS idx_post_reads_post ON post_reads(post_id);


-- ----------------------------------------------------------------------------
-- 7. post_audit_logs
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS post_audit_logs (
  id          BIGSERIAL   PRIMARY KEY,
  actor_id    INTEGER     REFERENCES users(user_id) ON DELETE SET NULL,
  action      VARCHAR(64) NOT NULL,
  target_type VARCHAR(32) NOT NULL,
  target_id   BIGINT,
  group_id    BIGINT      REFERENCES post_groups(id) ON DELETE CASCADE,
  metadata    JSONB,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_post_audit_group   ON post_audit_logs(group_id);
CREATE INDEX IF NOT EXISTS idx_post_audit_action  ON post_audit_logs(action);
CREATE INDEX IF NOT EXISTS idx_post_audit_actor   ON post_audit_logs(actor_id);
CREATE INDEX IF NOT EXISTS idx_post_audit_created ON post_audit_logs(created_at DESC);





BEGIN;

ALTER TABLE purchase_notifications RENAME TO mobile_notifications;

ALTER INDEX IF EXISTS idx_purchase_notifications_user_created
  RENAME TO idx_mobile_notifications_user_created;
ALTER INDEX IF EXISTS idx_purchase_notifications_user_unread
  RENAME TO idx_mobile_notifications_user_unread;
ALTER INDEX IF EXISTS idx_purchase_notifications_type
  RENAME TO idx_mobile_notifications_type;
ALTER INDEX IF EXISTS idx_purchase_notifications_purchase_type
  RENAME TO idx_mobile_notifications_purchase_type;
ALTER INDEX IF EXISTS idx_purchase_notifications_user_type
  RENAME TO idx_mobile_notifications_user_type;

SELECT COUNT(*) FROM mobile_notifications;
COMMIT;





-- Drop the old constraint first
ALTER TABLE mobile_notifications
  DROP CONSTRAINT IF EXISTS purchase_notifications_purchase_type_check;

-- Rename the column
ALTER TABLE mobile_notifications
  RENAME COLUMN purchase_type TO scope;

-- Add a fresh constraint with the new name
ALTER TABLE mobile_notifications
  ADD CONSTRAINT mobile_notifications_scope_check
  CHECK (scope IN ('local', 'foreign', 'posts'));

-- Rename the indexes so the names match the new column
ALTER INDEX IF EXISTS idx_mobile_notifications_purchase_type
  RENAME TO idx_mobile_notifications_scope;

ALTER INDEX IF EXISTS idx_mobile_notifications_user_type
  RENAME TO idx_mobile_notifications_user_scope;