-- Add GRN Number column
ALTER TABLE store_balance_histories 
ADD COLUMN grn_number VARCHAR(100) NULL;

-- Add SIV Number column
ALTER TABLE store_balance_histories 
ADD COLUMN siv_number VARCHAR(100) NULL;

-- Add indexes for better query performance
CREATE INDEX idx_grn_number ON store_balance_histories(grn_number);
CREATE INDEX idx_siv_number ON store_balance_histories(siv_number);

