-- ================================================================
-- TRIGGER - Prevent adding details to inactive formulations
-- ================================================================

CREATE OR REPLACE FUNCTION check_formulation_status_for_detail()
RETURNS TRIGGER AS $$
DECLARE
    formulation_status VARCHAR;
BEGIN
    -- Get the status of the parent formulation
    SELECT status INTO formulation_status 
    FROM formulations 
    WHERE id = NEW.formulation_id;
    
    -- Check if formulation is editable
    IF formulation_status NOT IN ('Draft', 'Active') THEN
        RAISE EXCEPTION 'Cannot add details to a % formulation', formulation_status;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_check_formulation_status_before_insert
    BEFORE INSERT ON formulation_details
    FOR EACH ROW
    EXECUTE FUNCTION check_formulation_status_for_detail();

-- Also check on update
CREATE TRIGGER trigger_check_formulation_status_before_update
    BEFORE UPDATE ON formulation_details
    FOR EACH ROW
    EXECUTE FUNCTION check_formulation_status_for_detail();
















