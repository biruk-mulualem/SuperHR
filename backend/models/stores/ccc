-- ================================================================
-- FINISHED GOODS TABLE
-- ================================================================
CREATE TABLE finished_goods (
    id SERIAL PRIMARY KEY,
    fg_code VARCHAR(20) UNIQUE NOT NULL,
    name VARCHAR(255) NOT NULL,
    type VARCHAR(20) NOT NULL CHECK (type IN ('Paint', 'Fiber')),
    status VARCHAR(20) DEFAULT 'Active' CHECK (status IN ('Active', 'Inactive', 'Discontinued')),
    
    -- Audit Fields
    created_by INTEGER REFERENCES users(user_id),
    updated_by INTEGER REFERENCES users(user_id),
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- ================================================================
-- INDEXES
-- ================================================================
CREATE INDEX idx_finished_goods_code ON finished_goods(fg_code);
CREATE INDEX idx_finished_goods_type ON finished_goods(type);
CREATE INDEX idx_finished_goods_status ON finished_goods(status);
CREATE INDEX idx_finished_goods_name ON finished_goods(name);

-- ================================================================
-- SEQUENCE FOR FG CODE
-- ================================================================
CREATE SEQUENCE finished_goods_code_seq START 1;

-- ================================================================
-- FUNCTION TO AUTO-GENERATE FG CODE
-- ================================================================
CREATE OR REPLACE FUNCTION generate_fg_code()
RETURNS TRIGGER AS $$
BEGIN
    NEW.fg_code := 'FG-' || LPAD(nextval('finished_goods_code_seq')::TEXT, 3, '0');
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ================================================================
-- TRIGGER TO AUTO-GENERATE FG CODE ON INSERT
-- ================================================================
CREATE TRIGGER trigger_generate_fg_code
BEFORE INSERT ON finished_goods
FOR EACH ROW
WHEN (NEW.fg_code IS NULL)
EXECUTE FUNCTION generate_fg_code();

