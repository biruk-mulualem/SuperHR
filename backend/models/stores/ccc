  ON purchase_requests(created_by_id);

-- 4. (Optional) Backfill legacy rows — assign to the first admin user
UPDATE purchase_requests
SET created_by_id = (
  SELECT u.user_id
  FROM users u
  JOIN roles r ON r.role_id = u.role_id
  WHERE r.name = 'admin'
  LIMIT 1
)
WHERE created_by_id IS NULL;






















CREATE TABLE purchase_follow_up_dispatches (
  id                     SERIAL PRIMARY KEY,

  -- Link to the PR header
  purchase_request_id    INTEGER NOT NULL
    REFERENCES purchase_requests(id)
    ON UPDATE CASCADE
    ON DELETE CASCADE,

  -- Nullable: the boss may be identified by name/email only
  user_id                INTEGER
    REFERENCES users(user_id)
    ON UPDATE CASCADE
    ON DELETE SET NULL,

  -- Snapshot of the person at dispatch time
  name                   VARCHAR(160) NOT NULL,
  department             VARCHAR(120),
  role                   VARCHAR(60),

  -- True when this row is the boss rather than a purchaser
  is_boss                BOOLEAN NOT NULL DEFAULT FALSE,

  -- Optional per-recipient message
  message                TEXT,

  -- Timestamps
  created_at             TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at             TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Indexes
CREATE INDEX pfud_pr_idx
  ON purchase_follow_up_dispatches (purchase_request_id);

CREATE INDEX pfud_user_idx
  ON purchase_follow_up_dispatches (user_id);

CREATE INDEX pfud_boss_idx
  ON purchase_follow_up_dispatches (is_boss);

















  CREATE TABLE purchase_follow_up_prices (
  id                          SERIAL PRIMARY KEY,

  -- Link to the PR line item (the source of truth)
  purchase_request_item_id    INTEGER NOT NULL
    REFERENCES purchase_request_items(id)
    ON UPDATE CASCADE
    ON DELETE CASCADE,

  -- Sales person who quoted
  employee                    VARCHAR(160) NOT NULL,
  submitted_by_id             INTEGER
    REFERENCES users(user_id)
    ON UPDATE CASCADE
    ON DELETE SET NULL,

  -- Prices (all DECIMAL 15,2 for currency)
  unit_price                  DECIMAL(15, 2) NOT NULL DEFAULT 0,
  total_price                 DECIMAL(15, 2) NOT NULL DEFAULT 0,
  discount                    DECIMAL(15, 2) NOT NULL DEFAULT 0,
  final_price                 DECIMAL(15, 2) NOT NULL DEFAULT 0,

  -- Requirement match + notes
  matches_requirement         BOOLEAN,
  remark                      TEXT,
  notes                       TEXT,

  -- Winner selection
  is_winner                   BOOLEAN NOT NULL DEFAULT FALSE,
  winner_manually_selected    BOOLEAN NOT NULL DEFAULT FALSE,

  -- Lifecycle
  status                      VARCHAR(20) NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'accepted', 'rejected')),
  submitted_date              TIMESTAMPTZ,

  -- Soft-delete
  removed_by_id               INTEGER
    REFERENCES users(user_id)
    ON UPDATE CASCADE
    ON DELETE SET NULL,
  removed_at                  TIMESTAMPTZ,
  removed_remark              TEXT,

  -- Timestamps
  created_at                  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at                  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Indexes
CREATE INDEX pfup_item_idx
  ON purchase_follow_up_prices (purchase_request_item_id);

CREATE INDEX pfup_status_idx
  ON purchase_follow_up_prices (status);

CREATE INDEX pfup_winner_idx
  ON purchase_follow_up_prices (is_winner);

CREATE INDEX pfup_submitter_idx
  ON purchase_follow_up_prices (submitted_by_id);













