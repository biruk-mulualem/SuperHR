-- CONVERTED BALANCES TABLE (Simple)
CREATE TABLE converted_balances (
    id SERIAL PRIMARY KEY,
    store_id INTEGER NOT NULL REFERENCES stores(id),
    group_id INTEGER NOT NULL REFERENCES groups(id),
    item_id INTEGER NOT NULL REFERENCES items(id),
    converted_balance DECIMAL(15,4) DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    -- Unique per store/group/item
    UNIQUE(store_id, group_id, item_id)
);

-- Indexes for performance
CREATE INDEX idx_converted_balances_store ON converted_balances(store_id);
CREATE INDEX idx_converted_balances_group ON converted_balances(group_id);
CREATE INDEX idx_converted_balances_item ON converted_balances(item_id);