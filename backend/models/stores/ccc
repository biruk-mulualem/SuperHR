CREATE TABLE IF NOT EXISTS purchasing_groups (
  id          SERIAL PRIMARY KEY,
  code        VARCHAR(40) UNIQUE NOT NULL,
  name        VARCHAR(120) NOT NULL,
  description TEXT,
  status      VARCHAR(20) NOT NULL DEFAULT 'active',
  created_at  TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
  updated_at  TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_purchasing_groups_status ON purchasing_groups(status);
CREATE INDEX IF NOT EXISTS idx_purchasing_groups_name   ON purchasing_groups(name);

-- ✅ references users(user_id) — matches your User model's PK
CREATE TABLE IF NOT EXISTS purchasing_group_members (
  id         SERIAL PRIMARY KEY,
  group_id   INTEGER NOT NULL REFERENCES purchasing_groups(id) ON DELETE CASCADE,
  user_id    INTEGER NOT NULL REFERENCES users(user_id)          ON DELETE CASCADE,
  role       VARCHAR(60),
  joined_at  TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
  UNIQUE (group_id, user_id)
);

CREATE INDEX IF NOT EXISTS idx_pgm_group_id ON purchasing_group_members(group_id);
CREATE INDEX IF NOT EXISTS idx_pgm_user_id  ON purchasing_group_members(user_id);

