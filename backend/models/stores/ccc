-- ================================================================
-- ORDERS TABLE - AUTO GENERATE ORDER NUMBER
-- ================================================================

CREATE OR REPLACE FUNCTION generate_order_number()
RETURNS TRIGGER AS $$
DECLARE
    year TEXT;
    next_id INTEGER;
    order_num TEXT;
BEGIN
    IF NEW.order_number IS NULL OR NEW.order_number = '' THEN
        year := EXTRACT(YEAR FROM CURRENT_DATE)::TEXT;
        SELECT COALESCE(MAX(id), 0) + 1 INTO next_id FROM orders;
        order_num := 'ORD-' || year || '-' || LPAD(next_id::TEXT, 3, '0');
        NEW.order_number := order_num;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_orders_generate_order_number
BEFORE INSERT ON orders
FOR EACH ROW
EXECUTE FUNCTION generate_order_number();

