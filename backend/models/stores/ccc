-- ================================================================
-- CREATE FORMULATIONS TABLE
-- ================================================================

CREATE TABLE formulations (
    id SERIAL PRIMARY KEY,
    finished_good_id INTEGER NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'Draft',
    description TEXT,
    version INTEGER NOT NULL DEFAULT 1,
    created_by INTEGER,
    updated_by INTEGER,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    
    -- 🔥 Foreign Key Constraints
    CONSTRAINT fk_formulations_finished_good 
        FOREIGN KEY (finished_good_id) 
        REFERENCES finished_goods(id) 
        ON UPDATE CASCADE 
        ON DELETE RESTRICT,
    
    CONSTRAINT fk_formulations_created_by 
        FOREIGN KEY (created_by) 
        REFERENCES users(user_id) 
        ON UPDATE CASCADE 
        ON DELETE SET NULL,
    
    CONSTRAINT fk_formulations_updated_by 
        FOREIGN KEY (updated_by) 
        REFERENCES users(user_id) 
        ON UPDATE CASCADE 
        ON DELETE SET NULL,
    
    -- 🔥 Check Constraints
    CONSTRAINT chk_formulations_status 
        CHECK (status IN ('Draft', 'Active', 'Inactive')),
    
    CONSTRAINT chk_formulations_version 
        CHECK (version >= 1)
);

-- ================================================================
-- INDEXES FOR PERFORMANCE
-- ================================================================

-- For finding formulations by finished good
CREATE INDEX idx_formulations_finished_good_id 
    ON formulations(finished_good_id);

-- For filtering by status
CREATE INDEX idx_formulations_status 
    ON formulations(status);

-- For sorting and version tracking
CREATE INDEX idx_formulations_version 
    ON formulations(version);

-- For date range queries
CREATE INDEX idx_formulations_created_at 
    ON formulations(created_at);

-- Composite index for common queries (finished good + status)
CREATE INDEX idx_formulations_finished_good_status 
    ON formulations(finished_good_id, status);

-- For searching by description (if you want full-text search later)
CREATE INDEX idx_formulations_description_gin 
    ON formulations USING GIN (to_tsvector('english', description));

-- ================================================================
-- TRIGGER FOR AUTO-UPDATE UPDATED_AT
-- ================================================================

CREATE OR REPLACE FUNCTION update_formulations_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_formulations_updated_at
    BEFORE UPDATE ON formulations
    FOR EACH ROW
    EXECUTE FUNCTION update_formulations_updated_at();


















