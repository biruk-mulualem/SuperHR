DROP TABLE IF EXISTS purchase_notifications;

CREATE TABLE purchase_notifications (
  id              SERIAL PRIMARY KEY,

  user_id         INTEGER NOT NULL
                  REFERENCES users(user_id)
                  ON DELETE CASCADE
                  ON UPDATE CASCADE,

  purchase_type   VARCHAR(20) NOT NULL DEFAULT 'local'
                  CHECK (purchase_type IN ('local', 'foreign')),

  type            VARCHAR(50) NOT NULL,

  title           VARCHAR(200) NOT NULL,

  body            TEXT,

  reference_id    INTEGER,
  reference_type  VARCHAR(50),

  metadata        JSONB DEFAULT '{}'::jsonb,

  is_read         BOOLEAN NOT NULL DEFAULT FALSE,
  read_at         TIMESTAMP,

  created_at      TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at      TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Indexes
CREATE INDEX idx_purchase_notifications_user_created
  ON purchase_notifications (user_id, created_at DESC);

CREATE INDEX idx_purchase_notifications_user_unread
  ON purchase_notifications (user_id, is_read)
  WHERE is_read = FALSE;

CREATE INDEX idx_purchase_notifications_type
  ON purchase_notifications (type);

CREATE INDEX idx_purchase_notifications_purchase_type
  ON purchase_notifications (purchase_type);

CREATE INDEX idx_purchase_notifications_user_type
  ON purchase_notifications (user_id, purchase_type, is_read);

