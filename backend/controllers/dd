/**
 * Get all items with cost calculations - OPTIMIZED
 * GET /api/item-costs
 */
exports.getItemsWithCost = async (req, res) => {
  try {
    const { storeId, groupId, status, search, page = 1, limit = 10 } = req.query;

    // Create cache key from all params
    const cacheKey = `items_${storeId || 'all'}_${groupId || 'all'}_${status || 'all'}_${search || 'all'}_${page}_${limit}`;
    
    // Check cache
    const cachedData = costCache.get(cacheKey);
    if (cachedData) {
      console.log('✅ Cache hit for:', cacheKey);
      return res.json(cachedData);
    }

    console.log('⏳ Cache miss for:', cacheKey);

    // Build query for items
    const itemWhere = {};
    
    if (search) {
      const searchTerm = search.toLowerCase();
      itemWhere[Op.or] = [
        { code: { [Op.like]: `%${searchTerm}%` } },
        { name: { [Op.like]: `%${searchTerm}%` } },
        { standardName: { [Op.like]: `%${searchTerm}%` } },
        { brand: { [Op.like]: `%${searchTerm}%` } },
        { model: { [Op.like]: `%${searchTerm}%` } },
      ];
    }

    // If store filter is applied, only get items that have balances in that store
    let itemIdsWithBalance = null;
    if (storeId) {
      const balances = await StoreBalance.findAll({
        where: {
          storeId: storeId,
          status: 'Active',
        },
        attributes: ['itemId'],
        group: ['itemId'],
      });
      
      itemIdsWithBalance = balances.map(b => b.itemId);
      
      if (itemIdsWithBalance.length === 0) {
        const emptyResponse = {
          success: true,
          data: [],
          pagination: {
            total: 0,
            page: parseInt(page),
            limit: parseInt(limit),
            pages: 0,
          },
        };
        costCache.set(cacheKey, emptyResponse);
        return res.json(emptyResponse);
      }
      
      itemWhere.itemId = { [Op.in]: itemIdsWithBalance };
    }

    const offset = (parseInt(page) - 1) * parseInt(limit);

    // Get items with pagination
    const { count, rows: items } = await Item.findAndCountAll({
      where: itemWhere,
      include: [
        { model: UOM, as: 'uom' },
        { model: Category, as: 'category' },
        { model: UOM, as: 'conversionUom' },
      ],
      order: [['name', 'ASC']],
      limit: parseInt(limit),
      offset: offset,
    });

    if (items.length === 0) {
      const emptyResponse = {
        success: true,
        data: [],
        pagination: {
          total: 0,
          page: parseInt(page),
          limit: parseInt(limit),
          pages: 0,
        },
      };
      costCache.set(cacheKey, emptyResponse);
      return res.json(emptyResponse);
    }

    // Get ALL balances in ONE query
    const itemIds = items.map(i => i.itemId);
    const balanceWhere = {
      itemId: { [Op.in]: itemIds },
      status: 'Active',
    };
    if (storeId) balanceWhere.storeId = storeId;
    if (groupId) balanceWhere.groupId = groupId;

    const allBalances = await StoreBalance.findAll({
      where: balanceWhere,
      include: [
        { model: Store, as: 'store', attributes: ['storeId', 'name', 'code'] },
        { model: Group, as: 'group', attributes: ['id', 'name', 'code'] },
        { model: Item, as: 'item', include: [{ model: UOM, as: 'uom' }] },
      ],
    });

    // Group balances by item
    const balancesByItem = {};
    for (const balance of allBalances) {
      if (!balancesByItem[balance.itemId]) {
        balancesByItem[balance.itemId] = [];
      }
      balancesByItem[balance.itemId].push(balance);
    }

    // Get latest costs in ONE query
    const ItemCost = db.ItemCost;
    let latestCosts = {};
    if (ItemCost) {
      const costRecords = await ItemCost.findAll({
        where: { itemId: { [Op.in]: itemIds } },
        order: [['created_at', 'DESC']],
        attributes: ['itemId', 'newCost', 'created_at'],
      });
      
      // Group by itemId and take first (latest)
      for (const cost of costRecords) {
        if (!latestCosts[cost.itemId]) {
          latestCosts[cost.itemId] = parseFloat(cost.newCost);
        }
      }
    }

    // Process each item using pre-fetched data
    const results = [];
    for (const item of items) {
      const itemBalances = balancesByItem[item.itemId] || [];
      const unitCost = latestCosts[item.itemId] || parseFloat(item.costPrice) || 0;
      
      const costData = calculateItemCostOptimized(
        item,
        itemBalances,
        unitCost,
        storeId || null,
        groupId || null
      );

      // Apply status filter - include 'Incomplete' and 'Error' statuses
      if (status) {
        if (status === 'Active' && costData.status !== 'Active') continue;
        if (status === 'Partial' && costData.status !== 'Partial') continue;
        if (status === 'Inactive' && costData.status !== 'Inactive') continue;
        if (status === 'Incomplete' && costData.status !== 'Incomplete') continue;
        if (status === 'Error' && costData.status !== 'Error') continue;
        if (status === 'Conflict' && costData.status !== 'Conflict') continue;
      }
      
      // Filter out items with zero quantity when store is selected (except incomplete/error items)
      if (storeId && costData.totalQty === 0 && costData.storeBreakdown.length === 0 && 
          costData.status !== 'Incomplete' && costData.status !== 'Error') {
        continue;
      }

      results.push(costData);
    }

    // Calculate correct total count based on filters
    let totalCount = count;
    
    // If status filter is applied, we need to count filtered items
    if (status || storeId) {
      // Get all items that match the base query (without pagination)
      const allItemsWhere = { ...itemWhere };
      if (storeId && itemIdsWithBalance) {
        allItemsWhere.itemId = { [Op.in]: itemIdsWithBalance };
      }
      
      const allItems = await Item.findAll({
        where: allItemsWhere,
        include: [
          { model: UOM, as: 'uom' },
          { model: Category, as: 'category' },
        ],
        order: [['name', 'ASC']],
      });
      
      // Get all balances for counting
      const allItemIds = allItems.map(i => i.itemId);
      const allBalancesForCount = await StoreBalance.findAll({
        where: {
          itemId: { [Op.in]: allItemIds },
          status: 'Active',
          ...(storeId && { storeId }),
          ...(groupId && { groupId }),
        },
      });
      
      const balancesByItemForCount = {};
      for (const b of allBalancesForCount) {
        if (!balancesByItemForCount[b.itemId]) balancesByItemForCount[b.itemId] = [];
        balancesByItemForCount[b.itemId].push(b);
      }
      
      // Get costs for counting
      let costsForCount = {};
      if (ItemCost) {
        const costRecords = await ItemCost.findAll({
          where: { itemId: { [Op.in]: allItemIds } },
          order: [['created_at', 'DESC']],
        });
        for (const cost of costRecords) {
          if (!costsForCount[cost.itemId]) {
            costsForCount[cost.itemId] = parseFloat(cost.newCost);
          }
        }
      }
      
      let filteredCount = 0;
      for (const item of allItems) {
        const itemBalances = balancesByItemForCount[item.itemId] || [];
        const unitCost = costsForCount[item.itemId] || parseFloat(item.costPrice) || 0;
        
        const costData = calculateItemCostOptimized(
          item,
          itemBalances,
          unitCost,
          storeId || null,
          groupId || null
        );
        
        if (status) {
          if (status === 'Active' && costData.status !== 'Active') continue;
          if (status === 'Partial' && costData.status !== 'Partial') continue;
          if (status === 'Inactive' && costData.status !== 'Inactive') continue;
          if (status === 'Incomplete' && costData.status !== 'Incomplete') continue;
          if (status === 'Error' && costData.status !== 'Error') continue;
          if (status === 'Conflict' && costData.status !== 'Conflict') continue;
        }
        if (storeId && costData.totalQty === 0 && costData.storeBreakdown.length === 0 && 
            costData.status !== 'Incomplete' && costData.status !== 'Error') continue;
        filteredCount++;
      }
      totalCount = filteredCount;
    }

    const response = {
      success: true,
      data: results,
      pagination: {
        total: totalCount,
        page: parseInt(page),
        limit: parseInt(limit),
        pages: Math.ceil(totalCount / parseInt(limit)),
      },
    };

    // Store in cache
    costCache.set(cacheKey, response);
    console.log('✅ Data cached for:', cacheKey);

    res.json(response);

  } catch (error) {
    console.error('Get items with cost error:', error);
    res.status(500).json({
      success: false,
      error: error.message || 'Failed to get items with cost',
    });
  }
};

/**
 * Get single item with cost calculation - OPTIMIZED
 * GET /api/item-costs/:itemId
 */
exports.getItemCost = async (req, res) => {
  try {
    const { itemId } = req.params;
    const { storeId, groupId } = req.query;

    // Get the item
    const item = await Item.findByPk(itemId, {
      include: [
        { model: UOM, as: 'uom' },
        { model: Category, as: 'category' },
        { model: UOM, as: 'conversionUom' },
      ],
    });

    if (!item) {
      return res.status(404).json({
        success: false,
        error: 'Item not found',
      });
    }

    // Get balances for this item
    const balanceWhere = {
      itemId: itemId,
      status: 'Active',
    };
    if (storeId) balanceWhere.storeId = storeId;
    if (groupId) balanceWhere.groupId = groupId;

    const balances = await StoreBalance.findAll({
      where: balanceWhere,
      include: [
        { model: Store, as: 'store', attributes: ['storeId', 'name', 'code'] },
        { model: Group, as: 'group', attributes: ['id', 'name', 'code'] },
        { model: Item, as: 'item', include: [{ model: UOM, as: 'uom' }] },
      ],
    });

    // Get latest cost
    const ItemCost = db.ItemCost;
    let unitCost = parseFloat(item.costPrice) || 0;
    if (ItemCost) {
      const latestCost = await ItemCost.findOne({
        where: { itemId: itemId },
        order: [['created_at', 'DESC']],
      });
      if (latestCost) {
        unitCost = parseFloat(latestCost.newCost);
      }
    }

    // Calculate cost
    const costData = calculateItemCostOptimized(
      item,
      balances,
      unitCost,
      storeId || null,
      groupId || null
    );

    // Get cost history
    const history = await getItemCostHistory(parseInt(itemId), 10);
    costData.costHistory = history;

    res.json({
      success: true,
      data: costData,
    });

  } catch (error) {
    console.error('Get item cost error:', error);
    res.status(500).json({
      success: false,
      error: error.message || 'Failed to get item cost',
    });
  }
};

